{
  "name": "jt-studio",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && node scripts/write-legacy-sitemap.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "build:fixture": "node scripts/build-blog.mjs --mode fixture --release tests/fixtures/empty-release.json",
    "build:fixture:published": "node scripts/build-blog.mjs --mode fixture --release tests/fixtures/published-release.json --outDir dist/published-fixture",
    "build:fixture:browser": "node scripts/build-public-browser-fixture.mjs",
    "test:unit": "node --test tests/unit/*.test.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:legacy": "node --test tests/legacy/legacy-build.test.mjs",
    "test:browser": "playwright test",
    "build:media-harness": "node scripts/build-media-harness.mjs",
    "rebuild:heif-codec": "bash scripts/build-heif-codec/rebuild.sh",
    "test:e2e": "node tests/e2e/run.mjs"
  },
  "dependencies": {
    "@jsquash/webp": "1.5.0",
    "@supabase/supabase-js": "2.117.3",
    "@tailwindcss/vite": "^4.1.18",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-helmet-async": "3.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^7.11.0",
    "sharp": "0.35.5",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "1.64.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react-swc": "^4.2.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "netlify-cli": "27.12.0",
    "parse5": "8.0.1",
    "pg": "8.23.1",
    "supabase": "2.120.0",
    "vite": "npm:rolldown-vite@7.2.5"
  },
  "overrides": {
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
